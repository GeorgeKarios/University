float avgsqrsum(int n1, int n2, int n3, int n4){
    return ((n1*n1)+(n2*n2)+(n3*n3)+(n4*n4)); 
}                                                  //calculates the sum of the squares

int cubesum(int n1, int n2, int n3, int n4){
    return (pow(n1,3)+pow(n2,3)+pow(n3,3)+pow(n4,3));
}                              

float equation(int n1, int n2, int n3, int n4, char cd){
    switch (cd){
        case 'S': printf("SUM OF THE SQUARES: %f", avgsqrsum( n1, n2, n3, n4));
             break;
